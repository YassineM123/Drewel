PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
APP_JWT_EXPIRES_IN=7d
# jsonwebtoken duration syntax, for example: 30m, 8h, or 1d
ADMIN_JWT_EXPIRES_IN=8h

# Secure ride communication (server-side secrets only)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=300
CALL_RING_TIMEOUT_SECONDS=30
CALL_EXPIRY_SWEEP_INTERVAL_MS=10000
RIDE_CONTACT_GRACE_PERIOD_MINUTES=30

# Ride navigation and lifecycle security. The Routes key is server-only and
# must be restricted to the Routes API and production backend egress.
GOOGLE_ROUTES_API_KEY=
PICKUP_GEOFENCE_METERS=100
DESTINATION_GEOFENCE_METERS=100
PICKUP_PIN_MAX_ATTEMPTS=5
PICKUP_PIN_RATE_WINDOW_MS=900000
# High-entropy server secret for the recoverable user PIN. Never expose it to
# mobile clients; rotate only with a controlled active-ride migration.
PICKUP_PIN_ENCRYPTION_KEY=replace-with-a-long-random-secret
RIDE_LOCATION_MIN_INTERVAL_MS=3000
RIDE_LOCATION_MAX_ACCURACY_METERS=100
RIDE_LOCATION_MAX_SPEED_KPH=220
# Marketplace GPS fixes older than this are excluded. Driver heartbeat is 10s.
DRIVER_LOCATION_MAX_AGE_MS=45000
# Reject repeated cached GPS measurements even if their heartbeat arrives now.
DRIVER_LOCATION_MAX_FIX_AGE_MS=60000
DRIVER_LOCATION_FUTURE_SKEW_MS=30000

# Driver/admin presence is a separate server lease from marketplace GPS freshness.
DRIVER_PRESENCE_HEARTBEAT_INTERVAL_MS=20000
DRIVER_PRESENCE_TIMEOUT_MS=120000
DRIVER_PRESENCE_SWEEP_INTERVAL_MS=5000
# Fixes with worse accuracy are rejected and never enter marketplace discovery.
MARKETPLACE_LOCATION_MAX_ACCURACY_METERS=100

# Local marketplace QA. Default is disabled. Both the server flag and the
# appropriate comma-separated JWT account allowlist are required; never put
# these values in a mobile build or accept them from request headers.
DREWEL_TUNISIA_TEST_MODE=false
DREWEL_TUNISIA_TEST_DRIVER_IDS=
DREWEL_TUNISIA_TEST_USER_IDS=
# Coarse browser/desktop fixes are allowed only in the isolated Tunisia QA area.
DREWEL_TUNISIA_TEST_LOCATION_MAX_ACCURACY_METERS=50000
RIDE_ETA_REFRESH_INTERVAL_MS=60000
RIDE_ROUTE_REFRESH_INTERVAL_MS=120000
RIDE_ROUTE_DEVIATION_METERS=100
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=drewel-app
MONGO_FORCE_IPV4=true
# Optional, comma-separated DNS resolvers for environments where Node's local
# DNS stub refuses Atlas SRV/TXT lookups. Leave empty on healthy deployments.
MONGO_DNS_SERVERS=
ALLOW_START_WITHOUT_DB=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://admin-dreewel.com,https://www.admin-dreewel.com
# Optional local-only bootstrap for an isolated developer database.
LOCAL_ADMIN_BOOTSTRAP=false
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# File storage
# Use "local" for development uploads under ./public, or "s3" for AWS S3.
STORAGE_DRIVER=local
# Optional canonical origin used in uploaded asset URLs (no trailing slash).
# Recommended behind a reverse proxy so saved URLs do not depend on Host headers.
PUBLIC_API_URL=https://admin-dreewel.com
# Optional comma-separated origins found in legacy stored asset URLs.
LEGACY_ASSET_ORIGINS=
# Number of known reverse-proxy hops. Keep 0 unless the topology is known;
# PUBLIC_API_URL is the preferred production origin.
TRUST_PROXY_HOPS=0
AWS_REGION=us-east-1
AWS_S3_BUCKET=drewel-app-uploads
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key

# Meta WhatsApp Cloud API
# Use the Phone number ID from Meta Developers > WhatsApp > API Setup.
# This is not the phone number, WABA ID, app ID, or page ID.
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EA...
WHATSAPP_API_VERSION=v19.0
WHATSAPP_TEMPLATE_NAME=login_otp_verification
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_VERIFY_CONFIG_BEFORE_SEND=false

# Set true for local development when Meta credentials are not ready.
WHATSAPP_MOCK_OTP=false

# Twilio SMS OTP (required when using the SMS login/forgot-password flow)
TWILIOSID=replace-with-twilio-account-sid
TWILIOTOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000
# Driver points defaults. Runtime owner changes are stored in the protected
# PointsSettings singleton; these values are only secure server-side defaults.
WELCOME_DRIVER_POINTS=100
RIDE_OFFER_POINTS_COST=20
POINTS_LOW_BALANCE_THRESHOLD=20
TRIP_OFFER_TTL_SECONDS=300
POINTS_MAXIMUM_CONCURRENT_OFFERS=5
POINTS_JOB_INTERVAL_MS=10000
POINTS_OUTBOX_MAX_ATTEMPTS=10
POINTS_LARGE_ADJUSTMENT_THRESHOLD=1000
# Per-instance defaults. Use a shared express-rate-limit store when the API
# runs with more than one process or replica.
POINTS_OFFER_RATE_LIMIT_PER_MINUTE=10
POINTS_PURCHASE_REQUEST_RATE_LIMIT_PER_HOUR=5
POINTS_ADMIN_READ_RATE_LIMIT_PER_MINUTE=120
POINTS_ADMIN_ADJUSTMENT_RATE_LIMIT_PER_15_MINUTES=20
POINTS_SETTINGS_MUTATION_RATE_LIMIT_PER_15_MINUTES=10

# Financial access is default-deny. Configure at least one owner identity
# before using /api/admin/points. Comma-separated Mongo ObjectIds are preferred.
DREWEL_OWNER_ADMIN_IDS=
DREWEL_OWNER_ADMIN_EMAILS=
DREWEL_FINANCE_ADMIN_IDS=
DREWEL_FINANCE_ADMIN_EMAILS=
